class Solution {
    public int[] getAverages(int[] nums, int k) {
        int n=nums.length;
        if(k==0) return nums;
        long [] prefix = new long[n];
        prefix[0]=nums[0];
        for(int i=1;i<n;i++){
            prefix[i]=prefix[i-1]+nums[i];
        }

        int ans [] = new int[n];
        Arrays.fill(ans , -1);
        
        int size = 2*k+1;
        if(n<size) return ans;

        

        for(int i=k;i<n-k;i++){
            int left=i-k;
            int right = i+k;

            long sum = prefix[right];
            if(left>0) sum-=prefix[left-1];
            int avg =(int) (sum/size);

            ans[i]=avg;
        }
        return ans;
        

    }
}
