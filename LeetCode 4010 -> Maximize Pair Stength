class Solution {
    int gcd(int a , int b){
        while(a>0 && b>0){
            if(a>b) a = a%b;
            else b = b%a;
        }
        if(a==0) return b;
        return a;
    }
    public long maxPairStrength(int[] nums) {
        long ans = Long.MIN_VALUE;
        int n  = nums.length;
        for(int i=0;i<n-1;i++){
            for(int j=i+1;j<n;j++){
                int g = gcd(nums[i],nums[j]);
                long  temp = ((long)nums[i]*nums[j])/((long)g*g);
                ans = Math.max(ans , temp);
            }
        }
        return ans;
    }
}
