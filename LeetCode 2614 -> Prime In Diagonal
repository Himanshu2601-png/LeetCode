class Solution {
    boolean isPrime(int n){
        int ct=0;
        for(int i=1;i*i<=n;i++){
            if(n%i == 0) {
                ct++;
                if(n/i !=i) ct++;
            }
        }
        return ct == 2;
    }
    public int diagonalPrime(int[][] nums) {
        int ans = Integer.MIN_VALUE;
        int n = nums.length;
        for(int i=0;i<n;i++){
            if(isPrime(nums[i][i])) ans = Math.max(nums[i][i] ,ans);
            if(isPrime(nums[i][n-i-1])) ans = Math.max(nums[i][n-i-1] , ans);
        }

        return ans == Integer.MIN_VALUE ? 0 : ans;
    }
}
