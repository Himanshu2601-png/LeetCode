 Solution {
    public int longestOnes(int[] nums, int k) {
        int l=0,r=0,ans=0,zero=0;
        
        while(r<nums.length){
            
            if(nums[r]==0) zero++;
            while(zero>k){
                if(nums[l]==0){
                    zero--;
                }
                l++;
            }
            if(zero<=k){
                int len=r-l+1;
                ans= Math.max(ans,len);
            }
            r++;
        }
        return ans;
    }
}
