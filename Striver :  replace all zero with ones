class Solution {
    public int replaceZerosWithOnes(int N) {
        // Your code goes here
        String s = ""+N;
        StringBuilder sb = new StringBuilder();
        for(char c : s.toCharArray()){
            if(c == '0') sb.append('1');
            else sb.append(c);
        }

        int num = Integer.parseInt(sb.toString());
        return num;
    }
}
