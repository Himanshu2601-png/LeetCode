class Solution {
    public ArrayList<Integer> diffArray(int[] arr, int[][] opr) {
        // code here
        int n = arr.length;
        int [] diff = new int[n];
        for(int [] temp : opr){
            int x = temp[0];
            int y=temp[1];
            int val = temp[2];
            
            
            diff[x]+=val;
            if(y+1 < n)diff[y+1]-=val;
        }
        for(int i=1;i<n;i++){
            diff[i]+=diff[i-1];
        }
        ArrayList<Integer> ls =new ArrayList<>();
        for(int i=0;i<n;i++){
            ls.add(arr[i]+diff[i]);
        }
        return ls;
    }
}
