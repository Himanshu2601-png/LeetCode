class Solution {
  
    public String digitSum(String s, int k) {
        while(s.length()>k){
             StringBuilder sb = new StringBuilder();

            for(int i=0;i<s.length();i+=k){
               

                String st = (i+k < s.length()) ? s.substring(i , i+k) : s.substring(i);
                int sum=0;

                for(char c : st.toCharArray()){
                    sum +=c-'0';
                }
           sb.append(sum);
        }
        s = sb.toString();   
        
        }

        return s;
    }
}
