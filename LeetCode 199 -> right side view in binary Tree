/*
Definition for Node
class Node {
    int data;
    Node left, right;

    Node(int val) {
        this.data = val;
        this.left = null;
        this.right = null;
    }
}
*/

class Solution {
    public ArrayList<Integer> rightView(Node root) {
        // code here
        ArrayList<Integer> ans = new ArrayList<>();
        if(root == null) return ans;
        
        Queue<Node> q = new LinkedList<>();
        q.add(root);
        
        while(!q.isEmpty()){
            int n = q.size();
            Node node = null;
            
            while(n>0){
                node = q.peek();
                q.poll();
                
                if(node.left!=null){
                    q.add(node.left);
                }
                
                 if(node.right!=null){
                    q.add(node.right);
                }
                n--;
            }
            ans.add(node.data);
        }
        return ans;
    }
}
