class Solution {
    int fact(int n){
        if(n<=1) return 1;
        return n*fact(n-1);
    }
    String isStrongNumber(int n) {
        // Your code goes here
        int org =n,sum=0;
        while(n>0){
            int rem = n%10;
            sum+=fact(rem);
            n/=10;
        }
        if(sum == org) return "Yes";
        else return "No";


    }
}
