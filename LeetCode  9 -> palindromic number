class Solution {
    public boolean isPalindrome(int x) {
        // int num =x;
        // int num2=0;
        // while(num>0){
        //     int rem = num%10;
        //     num2 = num2*10 + rem;
        //     num/=10;
        // }
        // return num2 == x;


        String s = ""+x;

        int i=0 , j= s.length()-1;

        while(i<=j){
            if(s.charAt(i)!=s.charAt(j)) return false;

            i++;
            j--;
        }
        return true;
    }
}
