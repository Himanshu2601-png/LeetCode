class Solution {
    public static int findSum(String s) {
        // code here
        
        int sum =0;
        String t = "0";
        for(char c : s.toCharArray()){
            if(Character.isDigit(c)){
                t +=c;
            }
            else{
                sum+=Integer.parseInt(t);
                t ="0";
            }
            
        }    
        
        return sum  + Integer.parseInt(t);
    }
}
