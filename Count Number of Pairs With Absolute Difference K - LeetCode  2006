class Solution {
    public int countKDifference(int[] nums, int k) {
        int count=0;
        int n = nums.length;
        for(int i=0;i<n-1;i++){
            for(int j=i+1;j<n;j++){
                int diff = nums[i]-nums[j];
                if(Math.abs(diff) == k) count++; 
            }

        }
        return count;
    }
}
